# Paron v2 — every variable is OPTIONAL. With none set, the whole stack runs in deterministic,
# cryptographically signed local mode (`npm run verify:all`, `npm run demo:swarm`, `npm run dev`).
# Never commit real keys: .env is gitignored.

# ── Live NEAR testnet agent (npm --prefix agents run agent:live -- cfo|mm|consumer|status [--execute])
NEAR_ACCOUNT_ID=            # e.g. cfo.your-treasury.testnet
NEAR_PRIVATE_KEY=           # ed25519:... Function Call access key scoped to PARON_CONTRACT_ID (recommended)
NEAR_KEY_KIND=FunctionCall  # FunctionCall | FullAccess
PARON_CONTRACT_ID=          # deployed paron-core account, e.g. market.your.testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
PARON_SERIES_ID=CU-2026-11

# ── NEAR Intents 1Click (live quotes; without a JWT the swarm uses deterministic local quotes)
ONE_CLICK_JWT=
ONE_CLICK_LIVE=0            # 1 = call the live API even without a JWT (fee applies)

# ── OutLayer TEE worker (deployed wasm32-wasip2 build of tee-worker/outlayer-cri-oracle)
OUTLAYER_API_URL=           # HTTPS execution endpoint of your OutLayer project
OUTLAYER_API_KEY=           # payment / API key for that endpoint
PARON_TEE_SIGNING_SEED_HEX= # native worker only: 32-byte hex seed (OutLayer builds use enclave signing_keys)

# ── Web terminal (Next.js; NEXT_PUBLIC_* are exposed to the browser — never put secrets here)
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_PARON_CONTRACT_ID=
NEXT_PUBLIC_USDC_TOKEN_ID=usdc.fakes.testnet
